<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tawakkalna_config_form" model="ir.ui.view">
        <field name="name">tawakkalna.config.form</field>
        <field name="model">tawakkalna.config</field>
        <field name="arch" type="xml">
            <form string="Tawakkalna API Configuration">
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="environment"/>
                            <field name="client_id"/>
                            <field name="client_secret" password="True"/>
                            <field name="default_language"/>
                        </group>
                        <group string="Token Status">
                            <field name="access_token" readonly="1"/>
                            <field name="token_issued_at" readonly="1"/>
                            <field name="token_expires_at" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tawakkalna_config_list" model="ir.ui.view">
        <field name="name">tawakkalna.config.list</field>
        <field name="model">tawakkalna.config</field>
        <field name="arch" type="xml">
            <list string="Tawakkalna API Configuration">
                <field name="company_id"/>
                <field name="environment"/>
                <field name="client_id"/>
                <field name="token_expires_at"/>
            </list>
        </field>
    </record>

    <record id="action_tawakkalna_config" model="ir.actions.act_window">
        <field name="name">API Settings</field>
        <field name="res_model">tawakkalna.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
