<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_hr_job_by_department" model="ir.actions.report">
        <field name="name">Job Hierarchy by Department</field>
        <field name="model">hr.department</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_job_hierarchy.report_job_by_department</field>
        <field name="print_report_name">'Job Hierarchy by Department - %s' % (object.env.company.name)</field>
        <field name="binding_model_id" ref="hr.model_hr_department"/>
        <field name="binding_type">report</field>
    </record>

    <!--
        Recursive node template: renders one department, then its own job
        positions as leaf rows, then recurses into child departments one
        level deeper. Same nesting pattern as hr_department_tree_report,
        with a job-position leaf layer added under each department.
    -->
    <template id="report_job_by_department_node">
        <div t-attf-class="dept_node dept_level_#{depth if depth &lt; 4 else 4}">
            <div class="dept_row">
                <span class="dept_name" t-esc="node.name"/>
                <span class="dept_meta">
                    <span t-if="node.manager_id" class="dept_manager" t-esc="node.manager_id.name"/>
                    <span t-if="node.total_employee" class="dept_badge">
                        <t t-esc="node.total_employee"/>
                        <t t-if="node.total_employee == 1"> employee</t>
                        <t t-else=""> employees</t>
                    </span>
                </span>
            </div>

            <t t-set="dept_jobs" t-value="node.env['hr.job'].search([('department_id', '=', node.id), ('active', '=', True)], order='name')"/>
            <div t-if="dept_jobs" class="dept_children job_leaf_group">
                <div t-foreach="dept_jobs" t-as="job" class="job_leaf_row">
                    <span class="job_leaf_name" t-esc="job.name"/>
                    <span t-if="job.no_of_employee" class="job_leaf_badge">
                        <t t-esc="job.no_of_employee"/>
                        <t t-if="job.no_of_employee == 1"> employee</t>
                        <t t-else=""> employees</t>
                    </span>
                </div>
            </div>

            <t t-set="child_depts" t-value="node.child_ids.filtered(lambda c: c.active).sorted(key=lambda c: c.name or '')"/>
            <div t-if="child_depts" class="dept_children">
                <t t-foreach="child_depts" t-as="child_dept">
                    <t t-call="hr_job_hierarchy.report_job_by_department_node">
                        <t t-set="node" t-value="child_dept"/>
                        <t t-set="depth" t-value="depth + 1"/>
                    </t>
                </t>
            </div>
        </div>
    </template>

    <template id="report_job_by_department">
        <t t-call="web.html_container">
            <t t-set="company" t-value="env.company"/>
            <t t-call="web.internal_layout">
                <div class="page o_dept_tree_report o_job_by_dept_report">
                    <style>
                        .o_dept_tree_report {
                            font-family: Arial, Helvetica, sans-serif;
                            color: #1A1A1A;
                            font-size: 11px;
                        }
                        .o_dept_tree_report .dept_report_header {
                            margin-bottom: 22px;
                            border-bottom: 2px solid #0D3B23;
                            padding-bottom: 10px;
                        }
                        .o_dept_tree_report .dept_report_header h1 {
                            color: #0D3B23;
                            margin: 0 0 4px 0;
                            font-size: 18px;
                        }
                        .o_dept_tree_report .dept_report_meta {
                            color: #666;
                            font-size: 11px;
                        }
                        .o_dept_tree_report .dept_node { margin: 2px 0; }
                        .o_dept_tree_report .dept_children {
                            margin-left: 22px;
                            padding-left: 10px;
                            border-left: 1px dashed #C9D6CF;
                        }
                        .o_dept_tree_report .dept_row {
                            display: flex;
                            align-items: center;
                            justify-content: space-between;
                            padding: 5px 10px;
                            border-radius: 4px;
                            margin: 2px 0;
                        }
                        .o_dept_tree_report .dept_level_0 > .dept_row {
                            background: #0D3B23;
                        }
                        .o_dept_tree_report .dept_level_0 > .dept_row .dept_name {
                            color: #FFFFFF; font-weight: 700; font-size: 13px;
                        }
                        .o_dept_tree_report .dept_level_0 > .dept_row .dept_manager { color: #D4AF37; }
                        .o_dept_tree_report .dept_level_1 > .dept_row {
                            background: #E3EEE7;
                            border-left: 3px solid #1B5E3F;
                            font-size: 12px;
                        }
                        .o_dept_tree_report .dept_level_2 > .dept_row {
                            background: #F3F8F5;
                            border-left: 3px solid #6FA98A;
                            font-size: 11px;
                        }
                        .o_dept_tree_report .dept_level_3 > .dept_row {
                            border-left: 3px solid #C9D6CF;
                            font-size: 10.5px;
                            font-weight: 400;
                        }
                        .o_dept_tree_report .dept_level_3 > .dept_row .dept_name { font-weight: 600; }
                        .o_dept_tree_report .dept_level_4 > .dept_row {
                            border-left: 3px solid #E4EAE7;
                            font-size: 10px;
                            font-weight: 400;
                            color: #555555;
                        }
                        .o_dept_tree_report .dept_name { font-weight: 600; }
                        .o_dept_tree_report .dept_meta { display: flex; align-items: center; gap: 10px; font-size: 10px; }
                        .o_dept_tree_report .dept_manager { color: #555; }
                        .o_dept_tree_report .dept_badge {
                            background: #D4AF37;
                            color: #1A1A1A;
                            border-radius: 10px;
                            padding: 1px 8px;
                            font-weight: 600;
                        }
                        .o_job_by_dept_report .job_leaf_group {
                            border-left-style: dotted !important;
                        }
                        .o_job_by_dept_report .job_leaf_row {
                            display: flex;
                            align-items: center;
                            justify-content: space-between;
                            padding: 3px 10px;
                            margin: 1px 0;
                            font-size: 10px;
                            font-style: italic;
                            color: #444;
                        }
                        .o_job_by_dept_report .job_leaf_row:before {
                            content: "\2022";
                            margin-right: 6px;
                            color: #6FA98A;
                        }
                        .o_job_by_dept_report .job_leaf_badge {
                            background: #EFEFEF;
                            color: #444;
                            border-radius: 10px;
                            padding: 1px 8px;
                            font-style: normal;
                        }
                    </style>

                    <t t-set="roots" t-value="docs.filtered(lambda d: not d.parent_id or d.parent_id not in docs).sorted(key=lambda d: d.name or '')"/>

                    <div class="dept_report_header">
                        <h1>Job Hierarchy by Department</h1>
                        <div class="dept_report_meta">
                            <span t-esc="company.name"/> —
                            <span t-esc="len(roots)"/> top-level department<t t-if="len(roots) != 1">s</t>,
                            <span t-esc="len(docs)"/> department<t t-if="len(docs) != 1">s</t> total —
                            generated <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/>
                        </div>
                    </div>

                    <div class="dept_tree_root">
                        <t t-foreach="roots" t-as="dept">
                            <t t-call="hr_job_hierarchy.report_job_by_department_node">
                                <t t-set="node" t-value="dept"/>
                                <t t-set="depth" t-value="0"/>
                            </t>
                        </t>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
